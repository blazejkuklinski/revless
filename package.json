{
	"name": "engine-drive",
	"version": "1.0.4",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host 0.0.0.0",
		"dev:https": "vite --host 0.0.0.0 --strictPort --mode local-https",
		"build": "tsc -b && vite build",
		"type-check": "tsc --noEmit",
		"deps-update": "ncu -u && npm install",
		"version-patch": "npm version patch --no-git-tag-version"
	},
	"dependencies": {
		"@heroui/react": "^3.2.8",
		"@heroui/styles": "^3.2.8",
		"@tailwindcss/vite": "^4.3.5",
		"clsx": "^2.1.1",
		"lucide-react": "^1.80.0",
		"maplibre-gl": "^6.19.0",
		"react": "^19.3.1",
		"react-countup": "^6.5.3",
		"react-dom": "^19.3.1",
		"recharts": "^3.11.1",
		"tailwindcss": "^4.3.5",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@types/react": "^19.3.3",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"npm-check-updates": "^23.1.1",
		"typescript": "~7.0.2",
		"vite": "^8.3.8"
	}
